  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#616B65"
      }
    },
    {
      "name": "Ordinary source",
      "scope": [
        "constant",
        "string",
        "variable",
        "variable.parameter",
        "entity.name.function",
        "entity.name.function.member",
        "entity.name.method",
        "entity.other.attribute-name",
        "punctuation"
      ],
      "settings": {
        "foreground": "#1B1F1C"
      }
    },
    {
      "name": "Language structure",
      "scope": [
        "keyword",
        "keyword.operator",
        "storage.type",
        "storage.modifier",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.function",
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#4A6E7A"
      }
    },
    {
      "name": "Markup structure",
      "scope": [
        "markup.heading",
        "markup.link",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#4A6E7A"
      }
    },
    {
      "name": "Markup quotation",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#616B65"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#8F5A42"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#85602E"
      }
    }
  ],
  "semanticTokenColors": {
    "*.deprecated": "#85602E",
    "class": "#4A6E7A",
    "comment": "#616B65",
    "decorator": "#4A6E7A",
    "enum": "#4A6E7A",
    "enumMember": "#1B1F1C",
    "event": "#1B1F1C",
    "function": "#1B1F1C",
    "interface": "#4A6E7A",
    "keyword": "#4A6E7A",
    "label": "#4A6E7A",
    "macro": "#4A6E7A",
    "method": "#1B1F1C",
    "namespace": "#4A6E7A",
    "number": "#1B1F1C",
    "operator": "#4A6E7A",
    "parameter": "#1B1F1C",
    "property": "#1B1F1C",
    "regexp": "#1B1F1C",
    "string": "#1B1F1C",
    "struct": "#4A6E7A",
    "type": "#4A6E7A",
    "typeParameter": "#4A6E7A",
    "variable": "#1B1F1C"
  }
