  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9AA29C"
      }
    },
    {
      "name": "Ordinary source",
      "scope": [
        "constant",
        "string",
        "variable",
        "variable.parameter",
        "entity.name.function",
        "entity.name.function.member",
        "entity.name.method",
        "entity.other.attribute-name",
        "punctuation"
      ],
      "settings": {
        "foreground": "#E2E0D7"
      }
    },
    {
      "name": "Language structure",
      "scope": [
        "keyword",
        "keyword.operator",
        "storage.type",
        "storage.modifier",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.function",
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#789AA3"
      }
    },
    {
      "name": "Markup structure",
      "scope": [
        "markup.heading",
        "markup.link",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#789AA3"
      }
    },
    {
      "name": "Markup quotation",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9AA29C"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C47D6B"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#B49A67"
      }
    }
  ],
  "semanticTokenColors": {
    "*.deprecated": "#B49A67",
    "class": "#789AA3",
    "comment": "#9AA29C",
    "decorator": "#789AA3",
    "enum": "#789AA3",
    "enumMember": "#E2E0D7",
    "event": "#E2E0D7",
    "function": "#E2E0D7",
    "interface": "#789AA3",
    "keyword": "#789AA3",
    "label": "#789AA3",
    "macro": "#789AA3",
    "method": "#E2E0D7",
    "namespace": "#789AA3",
    "number": "#E2E0D7",
    "operator": "#789AA3",
    "parameter": "#E2E0D7",
    "property": "#E2E0D7",
    "regexp": "#E2E0D7",
    "string": "#E2E0D7",
    "struct": "#789AA3",
    "type": "#789AA3",
    "typeParameter": "#789AA3",
    "variable": "#E2E0D7"
  }
