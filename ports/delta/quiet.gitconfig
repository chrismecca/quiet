# Generated by quiet port delta. Do not edit.
#
# quiet features for delta. Include this file from ~/.gitconfig and
# select a feature:
#
#   [include]
#       path = /path/to/quiet.gitconfig
#   [delta]
#       features = quiet-night
#
# Syntax highlighting needs the quiet tmTheme installed in bat's cache.

[delta "quiet-day"]
    light = true
    syntax-theme = quiet-day
    keep-plus-minus-markers = true

    # Removed lines.
    minus-style = syntax "#FAE6D4"
    minus-non-emph-style = syntax "#FAE6D4"
    minus-emph-style = "#1B1F1C" "#FCD8C0"
    minus-empty-line-marker-style = normal "#FAE6D4"
    line-numbers-minus-style = "#8F5A42"

    # Added lines.
    plus-style = syntax "#E5EED8"
    plus-non-emph-style = syntax "#E5EED8"
    plus-emph-style = "#1B1F1C" "#D3E8C7"
    plus-empty-line-marker-style = normal "#E5EED8"
    line-numbers-plus-style = "#586E5C"

    # Unchanged lines and line numbers.
    zero-style = syntax
    line-numbers-zero-style = "#616B65"
    line-numbers-left-style = "#CDD1CA"
    line-numbers-right-style = "#CDD1CA"
    whitespace-error-style = reverse "#8F5A42"

    # Files and hunks.
    file-style = "#4A6E7A"
    file-decoration-style = ul "#CDD1CA"
    hunk-header-file-style = "#4A6E7A"
    hunk-header-line-number-style = "#616B65"
    hunk-header-decoration-style = box "#CDD1CA"
    inline-hint-style = "#616B65"

    # Search results.
    grep-file-style = "#4A6E7A"
    grep-line-number-style = "#616B65"
    grep-match-word-style = "#1B1F1C" "#E8ECE2"

[delta "quiet-night"]
    dark = true
    syntax-theme = quiet-night
    keep-plus-minus-markers = true

    # Removed lines.
    minus-style = syntax "#251B16"
    minus-non-emph-style = syntax "#251B16"
    minus-emph-style = "#E2E0D7" "#341E15"
    minus-empty-line-marker-style = normal "#251B16"
    line-numbers-minus-style = "#C47D6B"

    # Added lines.
    plus-style = syntax "#172015"
    plus-non-emph-style = syntax "#172015"
    plus-emph-style = "#E2E0D7" "#182A15"
    plus-empty-line-marker-style = normal "#172015"
    line-numbers-plus-style = "#879A83"

    # Unchanged lines and line numbers.
    zero-style = syntax
    line-numbers-zero-style = "#9AA29C"
    line-numbers-left-style = "#343B38"
    line-numbers-right-style = "#343B38"
    whitespace-error-style = reverse "#C47D6B"

    # Files and hunks.
    file-style = "#789AA3"
    file-decoration-style = ul "#343B38"
    hunk-header-file-style = "#789AA3"
    hunk-header-line-number-style = "#9AA29C"
    hunk-header-decoration-style = box "#343B38"
    inline-hint-style = "#9AA29C"

    # Search results.
    grep-file-style = "#789AA3"
    grep-line-number-style = "#9AA29C"
    grep-match-word-style = "#E2E0D7" "#262D28"
