# Generated by quiet port fzf. Do not edit.
#
# quiet-night
#
# quiet color options for fzf. Load with:
#
#   export FZF_DEFAULT_OPTS_FILE=/path/to/quiet-night.fzfrc
#
# This file sets colors only.

# Base scheme.
--color=dark

# List.
--color=fg:#E2E0D7
--color=bg:#1C1E1C
--color=gutter:#1C1E1C
--color=hl:#789AA3

# Current line.
--color=fg+:#E2E0D7:regular
--color=bg+:#344246
--color=hl+:#E2E0D7:regular:bold
--color=pointer:#789AA3

# Multi-select.
--color=selected-bg:#262D28
--color=marker:#B49A67

# Input and status.
--color=query:#E2E0D7
--color=prompt:#789AA3
--color=ghost:#9AA29C
--color=disabled:#9AA29C
--color=info:#9AA29C
--color=spinner:#789AA3

# Preview.
--color=preview-bg:#242925
--color=preview-fg:#E2E0D7
--color=preview-scrollbar:#9AA29C

# Borders and labels.
--color=border:#343B38
--color=separator:#343B38
--color=scrollbar:#9AA29C
--color=label:#9AA29C

# Header and footer.
--color=header:#9AA29C
--color=footer:#9AA29C
