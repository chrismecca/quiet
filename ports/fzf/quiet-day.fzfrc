# Generated by quiet port fzf. Do not edit.
#
# quiet-day
#
# quiet color options for fzf. Load with:
#
#   export FZF_DEFAULT_OPTS_FILE=/path/to/quiet-day.fzfrc
#
# This file sets colors only.

# Base scheme.
--color=light

# List.
--color=fg:#1B1F1C
--color=bg:#EEEADF
--color=gutter:#EEEADF
--color=hl:#4A6E7A

# Current line.
--color=fg+:#1B1F1C:regular
--color=bg+:#D4DDE1
--color=hl+:#1B1F1C:regular:bold
--color=pointer:#4A6E7A

# Multi-select.
--color=selected-bg:#E8ECE2
--color=marker:#85602E

# Input and status.
--color=query:#1B1F1C
--color=prompt:#4A6E7A
--color=ghost:#616B65
--color=disabled:#616B65
--color=info:#616B65
--color=spinner:#4A6E7A

# Preview.
--color=preview-bg:#E6E9E2
--color=preview-fg:#1B1F1C
--color=preview-scrollbar:#616B65

# Borders and labels.
--color=border:#CDD1CA
--color=separator:#CDD1CA
--color=scrollbar:#616B65
--color=label:#616B65

# Header and footer.
--color=header:#616B65
--color=footer:#616B65
